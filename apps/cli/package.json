{
  "name": "@opennative/cli",
  "version": "0.1.0",
  "description": "OpenNative Interactive Terminal Gateway CLI",
  "main": "dist/index.js",
  "bin": {
    "opennative": "dist/index.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kanompung1988/OpenNative.git",
    "directory": "apps/cli"
  },
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@opennative/core-benchmark": "*",
    "@opennative/core-mt": "*",
    "@opennative/core-protector": "*",
    "@opennative/core-providers": "*",
    "@opennative/core-transcript": "*"
  },
  "license": "MIT"
}
